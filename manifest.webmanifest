{
  "id": "/?v=2",
  "name": "Mi Agenda Teocrática",
  "short_name": "Agenda Teocrática",
  "description": "Agenda personal: notas, eventos, tareas con seguimiento, personas y reuniones.",
  "lang": "es",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#EEF1EC",
  "theme_color": "#EEF1EC",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Registrar tiempo",
      "short_name": "Tiempo",
      "url": "./#/do/time",
      "icons": [
        {
          "src": "icons/n-soon.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Nueva tarea",
      "short_name": "Tarea",
      "url": "./#/do/task",
      "icons": [
        {
          "src": "icons/n-task.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Nueva reunión",
      "short_name": "Reunión",
      "url": "./#/do/meeting",
      "icons": [
        {
          "src": "icons/n-meeting.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Nota rápida",
      "short_name": "Nota",
      "url": "./#/do/note",
      "icons": [
        {
          "src": "icons/n-log.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "share_target": {
    "action": "./compartir-recibir",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "titulo",
      "text": "texto",
      "files": [
        {
          "name": "archivos",
          "accept": [
            "image/*",
            "application/pdf",
            ".pdf"
          ]
        }
      ]
    }
  }
}
