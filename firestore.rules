rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    // Administrador: tiene un documento admins/{su uid} (se crea a mano en la consola de Firebase)
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    // Cuenta aprobada: el administrador le asignó un tipo de perfil
    function approved(uid) { return exists(/databases/$(database)/documents/access/$(uid)); }

    // Datos de cada persona: solo ella los ve, y solo si su cuenta está aprobada (o es el administrador).
    // El administrador NO puede leer los datos de los demás.
    match /users/{uid}/{document=**} {
      allow read, write: if isSelf(uid) && (approved(uid) || isAdmin());
    }

    // Marca de administrador: cada uno puede ver si es administrador; nadie la escribe desde la app
    match /admins/{uid} {
      allow read: if isSelf(uid);
      allow write: if false;
    }

    // Tipo de perfil asignado: lo ve el propio usuario y el administrador; solo el administrador lo cambia.
    // type = id de una plantilla (las de siempre o una propia); allow/deny = funciones de más o de menos frente a su plantilla.
    match /access/{uid} {
      function okList(d, k) { return !(k in d) || (d[k] is list && d[k].size() <= 200); }
      allow read: if isSelf(uid) || isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['type', 'allow', 'deny', 'updatedAt', 'by'])
        && request.resource.data.type is string && request.resource.data.type.matches('^[a-z0-9_-]{1,30}$')
        && okList(request.resource.data, 'allow') && okList(request.resource.data, 'deny');
      allow delete: if isAdmin();
    }

    // Plantillas de funciones por tipo de perfil: las leen las cuentas aprobadas; solo el administrador las cambia
    match /config/plantillas {
      allow read: if signedIn() && (approved(request.auth.uid) || isAdmin());
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['types', 'updatedAt', 'by'])
        && request.resource.data.types is map && request.resource.data.types.size() <= 30
        && request.resource.data.by == request.auth.uid;
      allow delete: if isAdmin();
    }

    // Cuentas a las que se puede compartir: solo el nombre. Lo escribe cada uno; lo leen los aprobados.
    match /members/{uid} {
      allow read: if signedIn() && (approved(request.auth.uid) || isAdmin());
      allow create, update: if isSelf(uid) && (approved(uid) || isAdmin())
        && request.resource.data.keys().hasOnly(['name', 'updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 80;
      allow delete: if isSelf(uid) || isAdmin();
    }

    // Eventos compartidos: los ven quienes están en «members».
    // Mínimo privilegio: solo quien lo creó (owner) lo cambia, cambia con quién se comparte o lo borra.
    // Los demás solo pueden marcar su propio ✓ (doneLog) en un día.
    match /shared/{id} {
      function member() { return signedIn() && request.auth.uid in resource.data.members; }
      // Solo los campos que escribe la app (store.js: SHARED_FIELDS, datos de quién lo comparte y las marcas ✓)
      function ok(d) {
        return d.keys().hasOnly(['title', 'category', 'date', 'time', 'endTime', 'place', 'repeat', 'days', 'notes', 'theme', 'color',
            'skipDates', 'routine', 'owner', 'ownerName', 'members', 'memberNames', 'createdAt', 'updatedAt', 'updatedBy', 'updatedByName',
            'doneLog', 'doneAt', 'doneBy', 'doneDay'])
          && d.members is list && d.members.size() >= 2 && d.members.size() <= 30
          && d.owner in d.members && d.title is string && d.title.size() <= 120
          && (!('color' in d) || d.color == '' || (d.color is string && d.color.matches('^(#[0-9A-Fa-f]{3,8}|var[(]--[A-Za-z0-9_-]+[)])$')))
          && (!('doneLog' in d) || d.doneLog is map);
      }
      // En el día marcado (doneDay), la lista nueva solo se diferencia de la anterior por tu propio uid
      function onlyMeChanged(a, b) {
        return b.toSet().difference(a.toSet()).union(a.toSet().difference(b.toSet())).hasOnly([request.auth.uid]);
      }
      function myDayOnly(o, n, day) {
        return n.diff(o).affectedKeys().size() == 0
          || (n.diff(o).affectedKeys().hasOnly([day]) && onlyMeChanged(o.get(day, []), n.get(day, [])));
      }
      function onlyMyMark() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['doneLog', 'doneAt', 'doneBy', 'doneDay'])
          && request.resource.data.doneBy == request.auth.uid
          && request.resource.data.doneDay is string
          && myDayOnly(resource.data.get('doneLog', {}), request.resource.data.get('doneLog', {}), request.resource.data.doneDay);
      }
      allow read: if member();
      allow create: if signedIn() && (approved(request.auth.uid) || isAdmin())
        && id.matches('^[A-Za-z0-9_-]{1,40}$')
        && request.resource.data.owner == request.auth.uid && ok(request.resource.data);
      allow update: if member() && ok(request.resource.data)
        && request.resource.data.owner == resource.data.owner
        && (request.auth.uid == resource.data.owner || onlyMyMark());
      allow delete: if signedIn() && request.auth.uid == resource.data.owner;
    }

    // Tareas asignadas a otra cuenta. Las ven solo quien la asignó (owner) y quien la recibe (to).
    // Mínimo privilegio: quien asigna cambia el contenido o la borra; quien recibe solo la acepta o la rechaza,
    // anota avances y la marca hecha. Los avances ya anotados no se pueden borrar ni cambiar.
    match /assigned/{id} {
      function aOk(d) {
        return d.keys().hasOnly(['owner', 'ownerName', 'to', 'toName', 'title', 'notes', 'kind', 'priority', 'due', 'dueTime',
            'state', 'done', 'doneAt', 'log', 'createdAt', 'updatedAt', 'updatedBy'])
          && d.owner is string && d.to is string && d.owner != d.to
          && d.title is string && d.title.size() > 0 && d.title.size() <= 140
          && (!('notes' in d) || (d.notes is string && d.notes.size() <= 4000))
          && d.state in ['nueva', 'aceptada', 'rechazada'] && d.done is bool
          && (!d.done || d.state == 'aceptada')
          && d.log is list && d.log.size() <= 200;
      }
      function sameBase() {
        return request.resource.data.owner == resource.data.owner && request.resource.data.to == resource.data.to
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.log.size() >= resource.data.log.size()
          && request.resource.data.log[0:resource.data.log.size()] == resource.data.log;
      }
      allow read: if signedIn() && (request.auth.uid == resource.data.owner || request.auth.uid == resource.data.to);
      allow create: if signedIn() && (approved(request.auth.uid) || isAdmin())
        && id.matches('^[A-Za-z0-9_-]{1,40}$')
        && request.resource.data.owner == request.auth.uid && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.state == 'nueva' && request.resource.data.done == false && request.resource.data.log.size() == 0
        && aOk(request.resource.data);
      allow update: if signedIn() && aOk(request.resource.data) && sameBase()
        && ((request.auth.uid == resource.data.owner
              && request.resource.data.state == resource.data.state
              && request.resource.data.ownerName == resource.data.ownerName && request.resource.data.toName == resource.data.toName)
          || (request.auth.uid == resource.data.to
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state', 'done', 'doneAt', 'log', 'updatedAt', 'updatedBy'])
              && request.resource.data.state in ['aceptada', 'rechazada']));
      allow delete: if signedIn() && request.auth.uid == resource.data.owner;
    }

    // Buzón: el administrador deja un respaldo para otra cuenta; solo esa cuenta lo lee, lo importa y lo borra.
    // El administrador no puede leer lo que dejó ni los datos de la otra cuenta.
    match /inbox/{uid}/items/{id} {
      allow create: if isAdmin() && request.resource.data.from == request.auth.uid
        && request.resource.data.payload is string && request.resource.data.payload.size() < 900000;
      allow read, delete: if isSelf(uid);
    }

    // Enlace para los ancianos: el contenido llega cifrado con la clave (nadie lo puede leer sin ella).
    // Quien tiene el enlace lo pide por su número; nadie puede listar los enlaces. Solo quien lo creó lo cambia o lo apaga.
    match /shares/{id} {
      function okShare(d) {
        return d.keys().hasOnly(['owner', 'v', 'salt', 'iv', 'iter', 'ct', 'updatedAt'])
          && d.owner == request.auth.uid && d.ct is string && d.ct.size() < 900000
          && d.salt is string && d.salt.size() < 64 && d.iv is string && d.iv.size() < 64
          && d.iter is int && d.iter >= 100000 && d.iter <= 5000000;
      }
      allow get: if true;
      allow list: if false;
      allow create: if signedIn() && (approved(request.auth.uid) || isAdmin()) && okShare(request.resource.data);
      allow update: if signedIn() && resource.data.owner == request.auth.uid && okShare(request.resource.data);
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;
    }

    // Congregación compartida: el dueño (su uid es el id) comparte su organigrama, grupos, mecánicas, visita y publicadores.
    // Las cuentas en «members» lo leen (solo lectura); solo el dueño lo escribe o lo borra.
    match /congres/{cid} {
      function okHead(d) {
        return d.keys().hasOnly(['owner', 'ownerName', 'members', 'memberNames', 'name', 'updatedAt'])
          && d.owner == request.auth.uid && cid == request.auth.uid
          && d.members is list && d.members.size() >= 1 && d.members.size() <= 30
          && !(request.auth.uid in d.members)
          && (!('memberNames' in d) || d.memberNames is map)
          && (!('name' in d) || (d.name is string && d.name.size() <= 80));
      }
      allow read: if signedIn() && (request.auth.uid == resource.data.owner || request.auth.uid in resource.data.members);
      allow create: if signedIn() && (approved(request.auth.uid) || isAdmin()) && okHead(request.resource.data);
      allow update: if signedIn() && resource.data.owner == request.auth.uid && okHead(request.resource.data);
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;

      match /parts/{part} {
        function head() { return get(/databases/$(database)/documents/congres/$(cid)).data; }
        allow read: if signedIn() && (request.auth.uid == cid || request.auth.uid in head().members);
        allow create, update: if signedIn() && request.auth.uid == cid
          && part in ['depts', 'groups', 'mecas', 'visitas', 'people', 'congre']
          && request.resource.data.keys().hasOnly(['json', 'n', 'updatedAt'])
          && request.resource.data.json is string && request.resource.data.json.size() < 900000;
        allow delete: if signedIn() && request.auth.uid == cid;
      }
    }

    // Notas y tareas compartidas: las ven quienes están en «members». Solo quien la compartió (owner) cambia el
    // contenido, con quién se comparte o la borra; los demás solo agregan comentarios (no se borran ni se cambian).
    match /sharedItems/{id} {
      function member() { return signedIn() && request.auth.uid in resource.data.members; }
      function okItem(d) {
        return d.keys().hasOnly(['owner', 'ownerName', 'members', 'memberNames', 'kind', 'title', 'body', 'tag', 'date', 'about',
            'due', 'dueTime', 'status', 'priority', 'responsibles', 'log', 'comments', 'createdAt', 'updatedAt', 'updatedBy'])
          && d.members is list && d.members.size() >= 2 && d.members.size() <= 30 && d.owner in d.members
          && d.kind in ['note', 'task'] && d.title is string && d.title.size() <= 140
          && (!('body' in d) || (d.body is string && d.body.size() <= 20000))
          && (!('comments' in d) || (d.comments is list && d.comments.size() <= 500))
          && (!('log' in d) || (d.log is list && d.log.size() <= 100));
      }
      function oneMoreComment() {
        let before = resource.data.get('comments', []);
        let after = request.resource.data.comments;
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comments', 'updatedAt', 'updatedBy'])
          && request.resource.data.updatedBy == request.auth.uid
          && after.size() == before.size() + 1
          && after[0:before.size()] == before
          && after[before.size()].by == request.auth.uid
          && after[before.size()].t is string && after[before.size()].t.size() <= 1000;
      }
      allow read: if member();
      allow create: if signedIn() && (approved(request.auth.uid) || isAdmin())
        && id.matches('^[A-Za-z0-9_-]{1,40}$')
        && request.resource.data.owner == request.auth.uid && okItem(request.resource.data);
      allow update: if member() && okItem(request.resource.data)
        && request.resource.data.owner == resource.data.owner
        && (request.auth.uid == resource.data.owner || oneMoreComment());
      allow delete: if signedIn() && request.auth.uid == resource.data.owner;
    }

    // Directorio: cada usuario se anota con su correo (y nombre) para que el administrador lo encuentre
    match /directory/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create, update: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['email', 'name', 'lastSeen'])
        && request.resource.data.email == request.auth.token.email
        && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 80));
      allow delete: if isAdmin();
    }
  }
}
