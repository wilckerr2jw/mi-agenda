rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    // Administrador: tiene un documento admins/{su uid} (se crea a mano en la consola de Firebase)
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    // Cuenta aprobada: el administrador le asignó un tipo de perfil
    function approved(uid) { return exists(/databases/$(database)/documents/access/$(uid)); }

    // Datos de cada persona: solo ella los ve, y solo si su cuenta está aprobada (o es el administrador).
    // El administrador NO puede leer los datos de los demás.
    match /users/{uid}/{document=**} {
      allow read, write: if isSelf(uid) && (approved(uid) || isAdmin());
    }

    // Marca de administrador: cada uno puede ver si es administrador; nadie la escribe desde la app
    match /admins/{uid} {
      allow read: if isSelf(uid);
      allow write: if false;
    }

    // Tipo de perfil asignado: lo ve el propio usuario y el administrador; solo el administrador lo cambia
    match /access/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.type in ['publicador', 'precursor', 'anciano'];
      allow delete: if isAdmin();
    }

    // Cuentas a las que se puede compartir: solo el nombre. Lo escribe cada uno; lo leen los aprobados.
    match /members/{uid} {
      allow read: if signedIn() && (approved(request.auth.uid) || isAdmin());
      allow create, update: if isSelf(uid) && (approved(uid) || isAdmin())
        && request.resource.data.keys().hasOnly(['name', 'updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 80;
      allow delete: if isSelf(uid) || isAdmin();
    }

    // Eventos compartidos: los ven quienes están en «members».
    // Mínimo privilegio: solo quien lo creó (owner) lo cambia, cambia con quién se comparte o lo borra.
    // Los demás solo pueden marcar su propio ✓ (doneLog) en un día.
    match /shared/{id} {
      function member() { return signedIn() && request.auth.uid in resource.data.members; }
      function ok(d) {
        return d.members is list && d.members.size() >= 2 && d.members.size() <= 30
          && d.owner in d.members && d.title is string && d.title.size() <= 120;
      }
      function onlyMyMark() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['doneLog', 'doneAt', 'doneBy', 'doneDay'])
          && request.resource.data.doneBy == request.auth.uid;
      }
      allow read: if member();
      allow create: if signedIn() && (approved(request.auth.uid) || isAdmin())
        && request.resource.data.owner == request.auth.uid && ok(request.resource.data);
      allow update: if member() && ok(request.resource.data)
        && request.resource.data.owner == resource.data.owner
        && (request.auth.uid == resource.data.owner || onlyMyMark());
      allow delete: if signedIn() && request.auth.uid == resource.data.owner;
    }

    // Tareas asignadas a otra cuenta. Las ven solo quien la asignó (owner) y quien la recibe (to).
    // Mínimo privilegio: quien asigna cambia el contenido o la borra; quien recibe solo la acepta o la rechaza,
    // anota avances y la marca hecha. Los avances ya anotados no se pueden borrar ni cambiar.
    match /assigned/{id} {
      function aOk(d) {
        return d.keys().hasOnly(['owner', 'ownerName', 'to', 'toName', 'title', 'notes', 'kind', 'priority', 'due', 'dueTime',
            'state', 'done', 'doneAt', 'log', 'createdAt', 'updatedAt', 'updatedBy'])
          && d.owner is string && d.to is string && d.owner != d.to
          && d.title is string && d.title.size() > 0 && d.title.size() <= 140
          && (!('notes' in d) || (d.notes is string && d.notes.size() <= 4000))
          && d.state in ['nueva', 'aceptada', 'rechazada'] && d.done is bool
          && (!d.done || d.state == 'aceptada')
          && d.log is list && d.log.size() <= 200;
      }
      function sameBase() {
        return request.resource.data.owner == resource.data.owner && request.resource.data.to == resource.data.to
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.log.size() >= resource.data.log.size()
          && request.resource.data.log[0:resource.data.log.size()] == resource.data.log;
      }
      allow read: if signedIn() && (request.auth.uid == resource.data.owner || request.auth.uid == resource.data.to);
      allow create: if signedIn() && (approved(request.auth.uid) || isAdmin())
        && request.resource.data.owner == request.auth.uid && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.state == 'nueva' && request.resource.data.done == false && request.resource.data.log.size() == 0
        && aOk(request.resource.data);
      allow update: if signedIn() && aOk(request.resource.data) && sameBase()
        && ((request.auth.uid == resource.data.owner
              && request.resource.data.state == resource.data.state
              && request.resource.data.ownerName == resource.data.ownerName && request.resource.data.toName == resource.data.toName)
          || (request.auth.uid == resource.data.to
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state', 'done', 'doneAt', 'log', 'updatedAt', 'updatedBy'])
              && request.resource.data.state in ['aceptada', 'rechazada']));
      allow delete: if signedIn() && request.auth.uid == resource.data.owner;
    }

    // Buzón: el administrador deja un respaldo para otra cuenta; solo esa cuenta lo lee, lo importa y lo borra.
    // El administrador no puede leer lo que dejó ni los datos de la otra cuenta.
    match /inbox/{uid}/items/{id} {
      allow create: if isAdmin() && request.resource.data.from == request.auth.uid
        && request.resource.data.payload is string && request.resource.data.payload.size() < 900000;
      allow read, delete: if isSelf(uid);
    }

    // Enlace para los ancianos: el contenido llega cifrado con la clave (nadie lo puede leer sin ella).
    // Quien tiene el enlace lo pide por su número; nadie puede listar los enlaces. Solo quien lo creó lo cambia o lo apaga.
    match /shares/{id} {
      function okShare(d) {
        return d.keys().hasOnly(['owner', 'v', 'salt', 'iv', 'iter', 'ct', 'updatedAt'])
          && d.owner == request.auth.uid && d.ct is string && d.ct.size() < 900000
          && d.salt is string && d.salt.size() < 64 && d.iv is string && d.iv.size() < 64 && d.iter is int;
      }
      allow get: if true;
      allow list: if false;
      allow create: if signedIn() && (approved(request.auth.uid) || isAdmin()) && okShare(request.resource.data);
      allow update: if signedIn() && resource.data.owner == request.auth.uid && okShare(request.resource.data);
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;
    }

    // Directorio: cada usuario se anota con su correo (y nombre) para que el administrador lo encuentre
    match /directory/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create, update: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['email', 'name', 'lastSeen'])
        && request.resource.data.email == request.auth.token.email
        && (!('name' in request.resource.data) || request.resource.data.name.size() <= 80);
      allow delete: if isAdmin();
    }
  }
}
