{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "storage.rules",
      "LEEME.md",
      "**/.*",
      "node_modules/**",
      "functions/**",
      ".github/**",
      "ci/**",
      "calendario-*.json",
      "avisos/**",
      "mi-agenda-app-855f1-*.json",
      "*.key.json",
      "app-android/**",
      "*.apk",
      ".publicar/**",
      "**/.*/**",
      "*.md",
      "*.txt",
      "asignaciones-*.json",
      "Claude outputs/**",
      "vendor/LEEME.txt",
      "herramientas/**",
      "tests/**",
      "package.json",
      "empaquetar-para-claude.*"
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|html|webmanifest)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  }
}
